{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console", "Args": { "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact" } }
    ]
  },
  "AllowedHosts": "*",
  "Database": {
    "Provider": "SqlServer",
    "InitializeOnStartup": true,
    "ResetOnStartup": false
  },
  "ConnectionStrings": {
    "Sqlite": "Data Source=../../demo.db"
  },
  "Jwt": {
    "Issuer": "nexo-api",
    "Audience": "nexo-web",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Security": {
    "PasswordHashIterations": 210000
  },
  "Auth": {
    "RefreshCookieName": "nexo_refresh",
    "RefreshCookieSecure": true
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ]
  },
  "RateLimiting": {
    "ContactPermitLimit": 5,
    "ContactWindowSeconds": 600,
    "LoginPermitLimit": 10,
    "LoginWindowSeconds": 60,
    "RefreshPermitLimit": 30,
    "RefreshWindowSeconds": 60
  },
  "OpenApi": {
    "Enabled": false
  },
  "Site": {
    "Name": "Nexo Institucional",
    "Slogan": "Conectamos instituciones con soluciones",
    "Description": "Proveemos productos y bienes para instituciones públicas y privadas de Bolivia.",
    "TimeZoneId": "America/La_Paz",
    "Contact": {
      "Address": "Av. 16 de Julio (El Prado) 1490, La Paz, Bolivia",
      "Phone": "+591 2 2000000",
      "Whatsapp": "+591 70000000",
      "Email": "contacto@nexo.com.bo",
      "Hours": "Lunes a viernes, 08:30 a 18:30"
    },
    "Social": [
      { "Network": "facebook", "Url": "https://facebook.com/" },
      { "Network": "instagram", "Url": "https://instagram.com/" },
      { "Network": "linkedin", "Url": "https://linkedin.com/" }
    ],
    "Nav": [
      { "Label": "Inicio", "Href": "/" },
      { "Label": "Nosotros", "Href": "/nosotros" },
      { "Label": "Servicios", "Href": "/servicios" },
      { "Label": "Catálogo", "Href": "/catalogo" },
      { "Label": "Noticias", "Href": "/noticias" },
      { "Label": "Contacto", "Href": "/contacto" }
    ]
  }
}
